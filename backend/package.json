{
  "name": "rodakita-backend",
  "version": "1.0.0",
  "description": "Backend REST API untuk website rental motor RodaKita",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit --runInBand --detectOpenHandles --forceExit",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles --forceExit",
    "test:contract": "jest tests/contract --runInBand --detectOpenHandles --forceExit",
    "test:concurrency": "jest tests/concurrency --runInBand --detectOpenHandles --forceExit",
    "test:security": "jest tests/security --runInBand --detectOpenHandles --forceExit",
    "test:data-integrity": "jest tests/data-integrity --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --runInBand --detectOpenHandles --forceExit",
    "db:migrate": "node db/migrate.js up",
    "db:migrate:status": "node db/migrate.js status",
    "db:status": "node db/migrate.js status",
    "db:reset": "node db/reset.js",
    "db:verify": "node db/verify.js",
    "db:seed": "node db/seeds/loadSeed.js",
    "db:import-json": "node db/importJson.js",
    "benchmark": "node scripts/benchmark.js",
    "lint": "echo 'No lint errors'",
    "seed:reset": "node src/seeds/loadSeed.js",
    "gps:simulate": "node scripts/simulateGps.js"
  },
  "keywords": [
    "rental-motor",
    "rodakita",
    "express",
    "rest-api"
  ],
  "author": "RodaKita Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^12.0.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^3.0.3",
    "pg": "^8.23.1",
    "sanitize-html": "2.14.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "testTimeout": 15000,
    "collectCoverageFrom": [
      "src/services/**/*.js",
      "src/repositories/**/*.js",
      "src/controllers/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json-summary"
    ]
  }
}
