# ========================================================
# RodaKita Motor Rental Backend - Environment Variables
# ========================================================

# Server & Lingkungan
NODE_ENV=development
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Penyimpanan Database Driver: memory | postgres
USE_DB=postgres
DATABASE_URL=postgresql://localhost:5433/rodakita
DATABASE_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=15000
TEST_DATABASE_URL=postgresql://localhost:5433/rodakita_test

# Autentikasi & Keamanan JWT
JWT_SECRET=rodakita_super_secret_jwt_key_2026_wib_rental_min32chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Aturan Bisnis Pemesanan & Rental
BOOKING_EXPIRE_MINUTES=60
PAYMENT_EXPIRY_HOURS=2
MIN_RENTAL_DAYS=1
MAX_RENTAL_DAYS=30
WEEKEND_SURCHARGE=false
LATE_FEE_PERCENT_PER_HOUR=10

# Verifikasi Dokumen
REQUIRE_VERIFIED_DOCS=false
AUTO_VERIFY_DOCS=true
MAX_UPLOAD_MB=2
MAX_FILE_SIZE_MB=2
UPLOAD_PATH=uploads

# Penyedia Pembayaran & Integrasi
PAYMENT_PROVIDER=simulation
MIDTRANS_SERVER_KEY=SB-Mid-server-placeholder-sample-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-placeholder-sample-key
WEBHOOK_SECRET=rodakita_webhook_secret_simulation_2026

# Rate Limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=15
